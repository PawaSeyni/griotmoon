# Vite 8 declares an optional peer chain (@vitejs/devtools -> vitest ->
# webdriverio) that pins puppeteer-core <=24, while the prerender needs
# puppeteer-core 25 (to match @sparticuz/chromium). None of that chain is
# installed here, but npm's resolver still refuses the tree. Legacy peer
# resolution is the documented escape hatch; kept in .npmrc so local installs,
# CI and Netlify all resolve the same way.
legacy-peer-deps=true
