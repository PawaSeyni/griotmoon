{
  "name": "griotmoon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && node scripts/gen-sitemap.mjs && vite build && node scripts/fix-font-preload.mjs && npm run prerender",
    "build:spa": "tsc && node scripts/gen-sitemap.mjs && vite build && node scripts/fix-font-preload.mjs",
    "prerender": "node scripts/prerender.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "check:releases": "node scripts/check-amazon-releases.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:seo": "node scripts/check-seo-output.mjs",
    "check:i18n": "node scripts/check-i18n-catalog.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "report:funnels": "node scripts/report-funnels.mjs",
    "build:games-css": "tailwindcss -c scripts/games.tailwind.config.cjs -i scripts/games-tw-input.css -o public/games/games.css --minify",
    "patch:games": "node scripts/patch-games.mjs",
    "verify": "npm run check:i18n && npm run check:analytics && npm run build && npm run check:seo"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "^5.2.11",
    "lucide-react": "^1.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sparticuz/chromium": "^149.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "puppeteer": "^25.1.0",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-imagetools": "^12.0.1"
  }
}
