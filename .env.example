# Local environment for griotmoon (template). Copy to `.env`, which is git-ignored.
# Never commit real values.

# --- Plausible Stats API (scripts/report-funnels.mjs, `npm run report:funnels`) ---
# Stats API key from plausible.io → Account settings → API keys. Read-only aggregate
# stats; without it the report prints "No data".
PLAUSIBLE_API_KEY=
# Optional: defaults to griotmoon.com.
PLAUSIBLE_SITE_ID=

# --- Pinterest Conversions API (netlify/functions/_pinterest.mjs) ---
# Set in Netlify (griotmoon, Functions scope), not locally. BOTH are required; with
# either unset the conversion is silently skipped. There is no default ad account,
# on purpose: never point this at Eva's account (549770651316).
PINTEREST_CONVERSIONS_TOKEN=
PINTEREST_AD_ACCOUNT_ID=
