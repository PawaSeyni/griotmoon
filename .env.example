# Local environment for griotmoon (template). Copy to `.env`, which is git-ignored.
# Never commit real values.

# --- Plausible Stats API (scripts/report-funnels.mjs, `npm run report:funnels`) ---
# Stats API key from plausible.io → Account settings → API keys. Read-only aggregate
# stats; without it the report prints "No data".
PLAUSIBLE_API_KEY=
# Optional: defaults to griotmoon.com.
PLAUSIBLE_SITE_ID=
